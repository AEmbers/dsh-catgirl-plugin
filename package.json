{
  "name": "dsh-catgirl-plugin",
  "version": "0.2.1",
  "description": "Token-efficient catgirl persona runtime for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./catgirl-lite": "./catgirl-lite.js",
    "./catgirl-economy": "./catgirl-economy.js",
    "./decorate-core": "./decorate-core.js",
    "./neko-renderer": "./neko-renderer.js",
    "./usage-meter": "./usage-meter.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freakz2z/dsh-catgirl-plugin.git"
  },
  "homepage": "https://github.com/Freakz2z/dsh-catgirl-plugin#readme",
  "bugs": {
    "url": "https://github.com/Freakz2z/dsh-catgirl-plugin/issues"
  },
  "keywords": ["deepseek", "dsh", "plugin", "persona", "catgirl", "token-optimization"],
  "files": ["CHANGELOG.md", "index.js", "catgirl-lite.js", "catgirl-economy.js", "decorate-core.js", "decorate-core.d.ts", "neko-renderer.js", "usage-meter.js", "cordis.patch.yml"],
  "scripts": {
    "test": "node smoke-test.mjs && node economy-test.mjs && node renderer-test.mjs && node client/decorate-test.mjs && node decorate-parity-test.mjs",
    "test:composition": "node composition-test.mjs",
    "test:quality": "node run-quality-test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible"
      }
    }
  }
}
